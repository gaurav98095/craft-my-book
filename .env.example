# Copy this file to .env and fill in what you need. .env is gitignored.
# Loaded automatically (via python-dotenv) the first time src.ingestion.setup
# is imported, which every pipeline stage imports transitively.

# ---- Hugging Face -----------------------------------------------------------
# Needed if BOOK_MODEL_ID points at a gated repo, or you are rate-limited as
# an anonymous user. Picked up automatically by huggingface_hub/transformers,
# and also passed explicitly when loading the Stage 3 vision-language model.
HF_TOKEN=

# ---- Models -------------------------------------------------------------------
# The one model Pipelines B and C reuse for everything but speech-to-text.
BOOK_MODEL_ID=Qwen/Qwen3.6-27B-Instruct
# faster-whisper model size for Stage 1 speech-to-text.
WHISPER_MODEL_SIZE=large-v3

# ---- Compute ------------------------------------------------------------------
# device_map passed to AutoModelForImageTextToText.from_pretrained in Stage 3.
# "auto" spreads the model across available GPUs; set "cuda:0" or "cpu" to pin it.
DEVICE_MAP=auto
# Standard PyTorch/CUDA env var, respected natively -- set here for convenience.
# CUDA_VISIBLE_DEVICES=0

# ---- Storage layout -------------------------------------------------------------
# Where each stage reads/writes. Override if the corpus should live outside the
# repo (a scratch disk, a mounted volume). Relative paths are relative to the
# working directory the pipeline is launched from.
DATA_ROOT=./data
STORAGE_ROOT=./storage
OUTPUT_ROOT=./output
