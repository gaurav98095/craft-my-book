# Copy this file to .env and fill in what you need. .env is gitignored.
# Loaded automatically (via python-dotenv) the first time src.ingestion.setup
# is imported, which every pipeline stage imports transitively.

# ---- Which model answers every LLM call in the system ------------------------
# One switch decides local weights vs. a hosted API vs. a self-hosted server.
# Everything downstream (Stage 3's figure description, Pipeline B's tagging,
# Pipeline C's five agents) asks for an LLMClient and never imports a provider
# directly -- see src/llm/factory.py. Speech-to-text (Whisper) is separate and
# always local; it is not affected by this.
#
#   local              (default) a transformers checkpoint, loaded in-process
#   anthropic          Claude, via the Anthropic API
#   openai             GPT models, via the OpenAI API
#   groq               any model Groq hosts
#   gemini             Gemini, via its OpenAI-compatible endpoint
#   vllm               a self-hosted vLLM server
#   openai_compatible  anything else speaking that API shape (Ollama, LM
#                      Studio, TGI, ...)
LLM_PROVIDER=local

# The model id, in whatever form the chosen provider expects. Leave unset to
# use each provider's default (local: Qwen/Qwen3.6-27B-Instruct; anthropic:
# claude-sonnet-4-5; openai: gpt-4o; groq: llama-3.3-70b-versatile; gemini:
# gemini-2.5-flash). vllm and openai_compatible have no default -- you must
# set this to the model name your server is actually serving.
# LLM_MODEL=

# Required only for vllm / openai_compatible: the server's OpenAI-compatible
# endpoint. Not needed for groq/gemini (defaulted) or the hosted APIs.
# LLM_BASE_URL=http://localhost:8000/v1

# API keys -- set only the one your LLM_PROVIDER needs. LLM_API_KEY is a
# provider-agnostic fallback checked if the specific one above it is unset.
# Never commit a real key here -- if one ever gets pasted or typed into a
# chat, terminal share, or issue tracker, treat it as compromised and
# rotate it before using it.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# LLM_API_KEY=

# Downscale images to at most this many pixels on the long edge before
# sending them to any provider -- every one of them pays per pixel somehow.
MAX_IMAGE_SIDE=1280

# ---- LLM_PROVIDER=local only --------------------------------------------------
# Needed if the local checkpoint is a gated repo, or you're rate-limited as
# an anonymous Hugging Face user.
HF_TOKEN=
# device_map passed to from_pretrained. "auto" spreads the model across
# available GPUs; set "cuda:0" or "cpu" to pin it.
DEVICE_MAP=auto
# bfloat16 or float16.
LOCAL_MODEL_DTYPE=bfloat16
# Only if the optional flash-attn package is installed.
USE_FLASH_ATTENTION=false
# Standard PyTorch/CUDA env var, respected natively -- set here for convenience.
# CUDA_VISIBLE_DEVICES=0

# ---- Speech to text (always local) --------------------------------------------
WHISPER_MODEL_SIZE=large-v3

# ---- Storage layout -------------------------------------------------------------
# Where each stage reads/writes. Override if the corpus should live outside the
# repo (a scratch disk, a mounted volume). Relative paths are relative to the
# working directory the pipeline is launched from.
DATA_ROOT=./data
STORAGE_ROOT=./storage
OUTPUT_ROOT=./output
